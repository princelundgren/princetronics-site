---
import { Font, getImage } from 'astro:assets';
import CopyCodeButton from '../components/CopyCodeButton.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** The page's own path; leave it out for a page with no address of its own, such as the 404 page. */
  canonicalPath?: string;
  showLearning: boolean;
  image?: ImageMetadata;
  type?: 'website' | 'article';
  /** The navigation item to mark as the section this page belongs to. */
  currentSection?: 'projects' | 'articles' | 'learning' | 'about';
}

const { title, description, canonicalPath, showLearning, image, type = 'website', currentSection } = Astro.props;
const current = (section: Props['currentSection']) => (section === currentSection ? 'true' : undefined);
const site = import.meta.env.SITE;
const canonical = canonicalPath === undefined ? undefined : new URL(canonicalPath, site);
const ogImage = image ? new URL((await getImage({ src: image, width: 1200 })).src, site) : undefined;
const pageTitle = canonicalPath === '/' ? title : `${title} · PrinceTronics`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Font cssVariable="--font-heading" preload />
    <Font cssVariable="--font-text" preload />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="alternate" type="application/rss+xml" title="PrinceTronics" href="/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="PrinceTronics" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="site-header">
      <div>
        <a class="mark" href="/" aria-label="PrinceTronics">P</a>
        <nav aria-label="Main">
          <a href="/projects/" aria-current={current('projects')}>Projects</a>
          <a href="/articles/" aria-current={current('articles')}>Articles</a>
          {showLearning && <a href="/learning/" aria-current={current('learning')}>Learning</a>}
          <a href="/about/" aria-current={current('about')}>About</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <span>PrinceTronics</span>
        <nav aria-label="Footer">
          <a href="/follow/">Follow</a>
          <a href="/rss.xml">RSS</a>
          <a href="/about/">About</a>
        </nav>
      </div>
    </footer>
    <CopyCodeButton />
  </body>
</html>
