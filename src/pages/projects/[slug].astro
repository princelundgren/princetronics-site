---
import { render } from 'astro:content';
import EarlierDiscussion from '../../components/EarlierDiscussion.astro';
import EntryLayout from '../../layouts/EntryLayout.astro';
import { publishedEntries } from '../../lib/entries';
import { oldCommentsFor } from '../../lib/old-comments';

export async function getStaticPaths() {
  const projects = await publishedEntries('projects');
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const oldComments = await oldCommentsFor('projects', entry.id);
---

<EntryLayout entry={entry} section="projects">
  <Content />
  <EarlierDiscussion slot="discussion" comments={oldComments} />
</EntryLayout>
