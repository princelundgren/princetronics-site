---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { hasLearningEntries } from '../lib/navigation';
import { requirePage } from '../lib/pages';

const page = await requirePage('about');
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.summary} canonicalPath="/about/" showLearning={await hasLearningEntries()} currentSection="about">
  <h1>{page.data.title}</h1>
  <Content />
</BaseLayout>
