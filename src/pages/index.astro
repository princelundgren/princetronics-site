---
import { getEntry } from 'astro:content';
import EntryList from '../components/EntryList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { allPublishedEntries } from '../lib/entries';
import { hasLearningEntries } from '../lib/navigation';

const about = await getEntry('pages', 'about');
if (!about) throw new Error('The home page needs pages/about.md: its summary is the line under the site name');
const entries = await allPublishedEntries();
---

<BaseLayout
  title="PrinceTronics"
  description="Maker build guides and software projects, with the code and the lessons learned."
  canonicalPath="/"
  showLearning={await hasLearningEntries()}
>
  <h1>PrinceTronics</h1>
  <p class="summary">{about.data.summary}</p>
  <EntryList entries={entries} />
</BaseLayout>
