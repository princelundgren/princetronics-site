---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const sectionsAfterSteps = new Set(['troubleshooting', 'downloads']);
const sections = Astro.props.headings.filter((heading) => heading.depth === 2);
const steps = sections.filter((heading) => !sectionsAfterSteps.has(heading.slug));
const afterSteps = sections.filter((heading) => sectionsAfterSteps.has(heading.slug));
---

<nav class="on-this-page" aria-label="On this page">
  <p class="muted">On this page</p>
  <a href="#what-youll-need">What you’ll need</a>
  <ol>
    {steps.map((step) => <li><a href={`#${step.slug}`}>{step.text}</a></li>)}
  </ol>
  {afterSteps.map((section) => <a href={`#${section.slug}`}>{section.text}</a>)}
</nav>
