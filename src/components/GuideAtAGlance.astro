---
import type { Guide } from '../lib/schemas';

type Props = Pick<Guide, 'difficulty' | 'time' | 'cost'>;

const { difficulty, time, cost } = Astro.props;
const level = difficulty.charAt(0).toUpperCase() + difficulty.slice(1);
---

<p class="at-a-glance"><strong>At a glance:</strong> {`${level} · ${time} · ${cost}`}</p>
